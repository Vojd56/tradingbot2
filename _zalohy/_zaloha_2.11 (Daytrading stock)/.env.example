# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Channel ID where alerts and approval cards will be sent
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Trading 212 API Credentials
TRADING_212_API_KEY=your_t212_api_key_here
TRADING_212_SECRET_KEY=your_t212_secret_key_here
TRADING_212_ENV=demo

# Binance Futures Testnet API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_FUTURES_URL=https://testnet.binancefuture.com
